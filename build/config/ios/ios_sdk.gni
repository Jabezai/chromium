import("//build/config/apple/mobile_config.gni")
import("//build/config/ios/ios_sdk_overrides.gni")
import("//build/toolchain/rbe.gni")
import("//build/toolchain/siso.gni")
import("//build/toolchain/toolchain.gni")
import("//build_overrides/build.gni")

assert(current_os == "ios")
assert(use_system_xcode, "Hermetic xcode doesn't work for ios.")

declare_args() {
  ios_bin_path = ""
  ios_sdk_path = "/Applications/Xcode.app/Contents/Developer/Platforms/iPhoneOS.platform/Developer/SDKs/iPhoneOS18.4.sdk"
  ios_sdk_name = "iphoneos"
  ios_sdk_version = "18.4"
  ios_sdk_build = "18A5319i"
  ios_sdk_platform = ""
  ios_sdk_platform_path = ""
  ios_toolchains_path = ""
  ios_xcode_version = ""
  xcode_version_int = 0
  ios_xcode_build = ""
  machine_os_build = ""
  ios_sdk_developer_dir = ""
  ios_is_app_extension = false
  enable_testing = true
  ios_enable_test_targets = true
  ios_chromium_bundle_id = "com.charleslee.chromium"
  ios_enable_intents_extension = true
  ios_enable_credential_provider_extension = true
  ios_enable_share_extension = true
  ios_enable_push_notification_service_extension = true
  ios_enable_open_extension = true
  ios_enable_widget_kit_extension = true
  ios_enable_search_widget_extension = true
  ios_enable_content_widget_extension = true
}

declare_args() {
  ios_platform_build = ios_sdk_build
  if (target_environment == "simulator") {
    ios_platform_build = ""
  }
}

ios_use_xcode_symlinks =
    ios_sdk_path == "" && use_system_xcode && use_remoteexec

ios_sdk_info_args = [
  "--get_sdk_info",
  "--get_machine_info",
]
ios_sdk_info_args += [ ios_sdk_name ]
if (ios_sdk_developer_dir != "") {
  ios_sdk_info_args += [
    "--developer_dir",
    ios_sdk_developer_dir,
  ]
}
if (ios_use_xcode_symlinks) {
  ios_sdk_info_args += [
    "--create_symlink_at",
    "sdk/xcode_links",
    "--root_build_dir",
    root_build_dir,
  ]
}
script_name = "//build/config/apple/sdk_info.py"
_ios_sdk_result = exec_script(script_name, ios_sdk_info_args, "scope")
ios_bin_path =
    rebase_path("${_ios_sdk_result.toolchains_path}/usr/bin/", root_build_dir)
ios_sdk_platform_path = _ios_sdk_result.sdk_platform_path
ios_sdk_version = _ios_sdk_result.sdk_version
ios_sdk_build = _ios_sdk_result.sdk_build
ios_toolchains_path = _ios_sdk_result.toolchains_path
ios_xcode_version = _ios_sdk_result.xcode_version
xcode_version_int = _ios_sdk_result.xcode_version_int
ios_xcode_build = _ios_sdk_result.xcode_build
machine_os_build = _ios_sdk_result.machine_os_build
if (target_environment == "simulator") {
  ios_platform_build = ""
} else {
  ios_platform_build = ios_sdk_build
}

_sdk_root = rebase_path(ios_sdk_path, root_build_dir)
ios_sdk_logs = [ "ios_sdk_path=${_sdk_root}" ]