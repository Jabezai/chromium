ios_app_bundle_id_prefix = "com.charleslee"
ios_chromium_bundle_id = "com.charleslee.chromium"
ios_deployment_target = "18.0"
ios_enable_intents_extension = false
ios_enable_credential_provider_extension = false
ios_enable_share_extension = false
ios_enable_push_notification_service_extension = false
ios_enable_open_extension = false
ios_enable_widget_kit_extension = false
ios_enable_search_widget_extension = false
ios_enable_content_widget_extension = false
ios_enable_code_signing = true
ios_code_signing_identity_description = "Apple Development"
ios_enable_test_targets = false
ios_enable_dsyms = true
ios_enable_stripping = false
is_official_build = false
is_chrome_branded = false
target_os = "ios"
target_cpu = "arm64"
target_environment = "device"
enable_remoting = false
enable_testing = false
ios_sdk_path = "/Applications/Xcode.app/Contents/Developer/Platforms/iPhoneOS.platform/Developer/SDKs/iPhoneOS18.4.sdk"